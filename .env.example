# Deployment target
AZURE_SUBSCRIPTION_ID="<your_subscription_id>"
AZURE_TENANT_ID="<your_tenant_id>"
AZURE_LOCATION="uksouth"
# Name prefix: the <prefix> in every resource name (vnet-<prefix>, mlw-<prefix>, sg-<prefix>-admins, ...)
# and in the docs. 3-8 lowercase letters or digits. Do not change after the first deployment.
NAME_PREFIX="<prefix>"
# Resource group to deploy into. Independent of the prefix; rg-<prefix> is only a convention.
RESOURCE_GROUP_NAME="rg-<prefix>"

# Networking
VNET_ADDRESS_SPACE="10.0.0.0/16"
SERVICES_SUBNET_PREFIX="10.0.1.0/24"
GATEWAY_SUBNET_PREFIX="10.0.2.0/24"
DNS_INBOUND_SUBNET_PREFIX="10.0.3.0/28"
# Extra delegated subnet required for Flex Consumption VNet integration
FUNCTION_INTEGRATION_SUBNET_PREFIX="10.0.4.0/24"

# Access (RBAC): leave blank to create/reuse sg-<prefix>-admins and sg-<prefix>-developers,
# or set to the object ID of an existing Entra group
RBAC_ADMIN_GROUP_ID=""
RBAC_DEVELOPER_GROUP_ID=""

# AI Search tier: basic (cheapest with private endpoints; indexers and embeddings over private links) or
# standard (S1). Custom skills (Function App) and other Foundry skills need standard, because basic does not allow
# private connections for AI enrichment skillsets. The tier cannot be changed later. See docs/architecture.md
SEARCH_SKU="basic"
# Let the Foundry account's document features (Document Intelligence) read the Data Lake. It needs the Data Lake's public
# endpoint enabled, with a firewall rule that allows only the Foundry account, so it is off by default. See docs/architecture.md
FOUNDRY_LAKE_ACCESS="false"

# How people connect (step 5): vpn (trusted teams), bastion (third-party users), or both. See docs/accessing-the-environment.md
ACCESS_MODE="vpn"

# VPN Gateway (P2S, OpenVPN, Microsoft Entra ID auth)
VPN_GATEWAY_SKU="VpnGw1AZ"
VPN_CLIENT_ADDRESS_POOL="172.16.201.0/24"
# Public-cloud Azure VPN Client app ID
VPN_AAD_AUDIENCE="c632b3df-fb67-4d84-bdcf-b95ad541b5c8"

# Bastion (used when ACCESS_MODE is bastion or both): one Windows VM per user, each with its own generated password
BASTION_SKU="Basic"
BASTION_SUBNET_PREFIX="10.0.5.0/26"
VM_SUBNET_PREFIX="10.0.6.0/24"
# Number of VMs. Raising it later adds VMs; lowering it does not delete any.
VM_COUNT="3"
VM_SIZE="Standard_B2ms"
VM_DISK_GB="128"
# Daily shutdown as HHmm in VM_SHUTDOWN_TIMEZONE, or "none" to disable
VM_SHUTDOWN_TIME="1900"
VM_SHUTDOWN_TIMEZONE="UTC"
# A VM deallocates itself after this many minutes with no active session and no load (0 = off)
VM_IDLE_SHUTDOWN_MINUTES="30"
# Install VS Code, Python, Git and the Azure CLI on each VM
VM_INSTALL_TOOLS="true"