// Step 5, ACCESS_MODE=bastion or both: Azure Bastion and one Windows VM per user, each with its own local account.
// The VMs and the Bastion subnet come from step 1; this step does not create subnets.
import { resourceNames } from 'names.bicep'

param prefix string
param location string = resourceGroup().location
@allowed(['Basic', 'Standard'])
param bastionSku string = 'Basic'
@minValue(0)
@maxValue(20)
param vmCount int = 3
// VMs that already exist (their passwords cannot be changed by a redeployment), so only the rest are created.
@minValue(0)
param existingVmCount int = 0
param vmSize string = 'Standard_B2ms'
@minValue(64)
param vmDiskGb int = 128
// Comma-separated passwords, one per VM to create, in VM order. Generated by the deploy script.
@secure()
param vmPasswords string = ''
param installTools bool = true
// Minutes with no active session and no load before a VM deallocates itself. 0 turns it off.
@minValue(0)
param idleShutdownMinutes int = 30
// HHmm, or empty for no automatic shutdown.
param vmShutdownTime string = '1900'
param vmShutdownTimeZone string = 'UTC'

var n = resourceNames(prefix, resourceGroup().id)
var vnetId = resourceId('Microsoft.Network/virtualNetworks', n.vnet)
var bastionSubnetId = '${vnetId}/subnets/${n.bastionSubnet}'
var vmSubnetId = '${vnetId}/subnets/${n.vmSubnet}'
var newCount = max(vmCount - existingVmCount, 0)
var vmNames = [for i in range(0, newCount): '${n.vmBase}-${padLeft(string(existingVmCount + i + 1), 2, '0')}']
var vmUsers = [for i in range(0, newCount): 'vmuser${padLeft(string(existingVmCount + i + 1), 2, '0')}']
var vmContributorRole = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '9980e02c-c2be-4d73-94e8-173b1dc7cf3c')

resource bastionPip 'Microsoft.Network/publicIPAddresses@2024-05-01' = {
  name: n.bastionPip
  location: location
  sku: { name: 'Standard' }
  properties: {
    publicIPAllocationMethod: 'Static'
    publicIPAddressVersion: 'IPv4'
  }
}

resource bastion 'Microsoft.Network/bastionHosts@2024-05-01' = {
  name: n.bastion
  location: location
  sku: { name: bastionSku }
  properties: {
    ipConfigurations: [
      {
        name: 'bastion-ip'
        properties: {
          subnet: { id: bastionSubnetId }
          publicIPAddress: { id: bastionPip.id }
        }
      }
    ]
  }
}

resource nics 'Microsoft.Network/networkInterfaces@2024-05-01' = [
  for i in range(0, newCount): {
    name: 'nic-${vmNames[i]}'
    location: location
    properties: {
      ipConfigurations: [
        {
          name: 'ipconfig1'
          properties: {
            subnet: { id: vmSubnetId }
            privateIPAllocationMethod: 'Dynamic'
          }
        }
      ]
    }
  }
]

resource vms 'Microsoft.Compute/virtualMachines@2024-03-01' = [
  for i in range(0, newCount): {
    name: vmNames[i]
    location: location
    // The VM's own identity lets it deallocate itself when idle.
    identity: { type: 'SystemAssigned' }
    properties: {
      hardwareProfile: { vmSize: vmSize }
      osProfile: {
        computerName: take(vmNames[i], 15)
        adminUsername: vmUsers[i]
        // Taken from the secure vmPasswords parameter; the linter cannot see that through split().
        #disable-next-line use-secure-value-for-secure-inputs
        adminPassword: split(vmPasswords, ',')[i]
        windowsConfiguration: {
          provisionVMAgent: true
          enableAutomaticUpdates: true
        }
      }
      storageProfile: {
        imageReference: {
          publisher: 'MicrosoftWindowsServer'
          offer: 'WindowsServer'
          sku: '2022-datacenter-azure-edition'
          version: 'latest'
        }
        osDisk: {
          createOption: 'FromImage'
          diskSizeGB: vmDiskGb
          managedDisk: { storageAccountType: 'StandardSSD_LRS' }
        }
      }
      networkProfile: {
        networkInterfaces: [{ id: nics[i].id }]
      }
    }
  }
]

resource shutdown 'Microsoft.DevTestLab/schedules@2018-09-15' = [
  for i in range(0, newCount): if (!empty(vmShutdownTime)) {
    name: 'shutdown-computevm-${vms[i].name}'
    location: location
    properties: {
      status: 'Enabled'
      taskType: 'ComputeVmShutdownTask'
      dailyRecurrence: { time: vmShutdownTime }
      timeZoneId: vmShutdownTimeZone
      notificationSettings: { status: 'Disabled' }
      targetResourceId: vms[i].id
    }
  }
]

resource tools 'Microsoft.Compute/virtualMachines/runCommands@2024-03-01' = [
  for i in range(0, newCount): if (installTools || idleShutdownMinutes > 0) {
    parent: vms[i]
    name: 'configure-vm'
    location: location
    properties: {
      source: { script: loadTextContent('scripts/configure-vm.ps1') }
      parameters: [
        { name: 'SubscriptionId', value: subscription().subscriptionId }
        { name: 'ResourceGroup', value: resourceGroup().name }
        { name: 'VmName', value: vmNames[i] }
        { name: 'IdleMinutes', value: string(idleShutdownMinutes) }
        { name: 'InstallTools', value: string(installTools) }
      ]
      timeoutInSeconds: 1800
      treatFailureAsDeploymentFailure: false
    }
  }
]

// Each VM may manage only itself, which is what lets it deallocate when idle.
resource selfDeallocate 'Microsoft.Authorization/roleAssignments@2022-04-01' = [
  for i in range(0, newCount): if (idleShutdownMinutes > 0) {
    scope: vms[i]
    name: guid(vms[i].id, 'self-deallocate', vmContributorRole)
    properties: {
      principalId: vms[i].identity.principalId
      principalType: 'ServicePrincipal'
      roleDefinitionId: vmContributorRole
    }
  }
]

output bastionName string = bastion.name
output createdVms array = [
  for i in range(0, newCount): {
    name: vmNames[i]
    username: vmUsers[i]
  }
]
